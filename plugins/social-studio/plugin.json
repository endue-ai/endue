{
  "id": "endue.social-studio",
  "name": "Social Studio",
  "version": "0.1.0",
  "kind": "ui",
  "entry": "ui/index.html",
  "messages": "messages",
  "description": "Every social account the endue account connects in one window: the accounts' posts, the replies and mentions to them, their numbers, and drafts written once and published to each account.",
  "permissions": [
    {
      "permission": "data:read",
      "kinds": ["entry", "metric", "record"]
    },
    {
      "permission": "cmd:invoke",
      "ids": ["desk.connectors.open", "*.post.publish", "*.post.reply", "*.post.delete"]
    },
    {
      "permission": "shell:open",
      "schemes": ["https"]
    },
    {
      "permission": "connector:manage"
    },
    {
      "permission": "fs:read",
      "paths": ["${home}/Documents/Social Studio/**", "/**"]
    },
    {
      "permission": "fs:write",
      "paths": ["${home}/Documents/Social Studio/**"]
    },
    {
      "permission": "brain:ask"
    },
    {
      "permission": "account:manage"
    }
  ],
  "surfaces": [
    {
      "id": "main",
      "title": "Social Studio",
      "titleMessage": "title",
      "placement": "center",
      "window": {
        "size": {
          "width": 1080,
          "height": 720
        }
      }
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "endue.social-studio.open",
        "title": "Open Social Studio",
        "titleMessage": "open",
        "keywords": [
          "social",
          "sns",
          "instagram",
          "threads",
          "x",
          "reddit",
          "posts",
          "소셜",
          "SNS"
        ],
        "runs": {
          "command": "desk.plugins.open",
          "args": {
            "plugin": "endue.social-studio"
          }
        }
      },
      {
        "id": "endue.social-studio.view",
        "title": "Switch the Social Studio view",
        "titleMessage": "view",
        "keywords": ["social", "feed", "replies", "numbers", "drafts"],
        "args": {
          "type": "object",
          "properties": {
            "view": {
              "type": "string",
              "enum": ["feed", "replies", "numbers", "drafts"]
            }
          },
          "required": ["view"],
          "additionalProperties": false
        }
      },
      {
        "id": "endue.social-studio.accounts",
        "title": "Social Studio: accounts as data",
        "keywords": ["social", "accounts", "networks"],
        "description": "The social accounts, by network, as data, leaving the screen as it is: each with source (to name it in posts and numbers), title, network, state, the sentence that explains an error or a pause, reauth (true when it must be reconnected on endue.ai), handle, followers and capabilities (what the network lets the account do).",
        "args": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "accounts": {
              "type": "array"
            }
          }
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.social-studio.posts",
        "title": "Social Studio: posts as data",
        "keywords": ["social", "posts", "feed"],
        "description": "The accounts' own posts, newest first, as data: each with source and id (to show it or read its replies), network, author, handle, at, text, url, counts (only those the network gives: likes, replies, reposts, views) and media kinds. source narrows to one account, network to one network (instagram, threads…), query to posts holding the words. Up to limit (20, at most 100).",
        "args": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "connector": {
                  "type": "string"
                },
                "instance": {
                  "type": "string"
                }
              },
              "required": ["connector", "instance"],
              "additionalProperties": false
            },
            "network": {
              "type": "string",
              "maxLength": 100
            },
            "query": {
              "type": "string",
              "maxLength": 200
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "posts": {
              "type": "array"
            },
            "more": {
              "type": "boolean"
            }
          }
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.social-studio.replies",
        "title": "Social Studio: replies and mentions as data",
        "keywords": ["social", "replies", "mentions", "comments"],
        "description": "Replies and mentions to the accounts, the unseen first, as data, each as posts answers them with seen. With { source, id } of a post, only the replies to it; else source, network and query narrow as in posts. Up to limit (20, at most 100); unseen counts them all.",
        "args": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "connector": {
                  "type": "string"
                },
                "instance": {
                  "type": "string"
                }
              },
              "required": ["connector", "instance"],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "network": {
              "type": "string",
              "maxLength": 100
            },
            "query": {
              "type": "string",
              "maxLength": 200
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "replies": {
              "type": "array"
            },
            "unseen": {
              "type": "integer"
            },
            "more": {
              "type": "boolean"
            }
          }
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.social-studio.numbers",
        "title": "Social Studio: an account's numbers as data",
        "keywords": ["social", "insights", "followers", "reach", "engagement"],
        "description": "One account's numbers as data: each series (followers, reach, engagement…) with its unit, latest point and up to 90 points, and the account's best posts (most likes, then replies). The account is { source } as accounts answers it; a network that gives no numbers has no series.",
        "args": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "connector": {
                  "type": "string"
                },
                "instance": {
                  "type": "string"
                }
              },
              "required": ["connector", "instance"],
              "additionalProperties": false
            }
          },
          "required": ["source"],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "series": {
              "type": "array"
            },
            "best": {
              "type": "array"
            }
          }
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.social-studio.show",
        "title": "Show a social post in Social Studio",
        "keywords": ["social", "post", "open"],
        "description": "Open a post, reply or mention in Social Studio and bring the window up. The post is { source, id } as posts and replies answer them.",
        "args": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "connector": {
                  "type": "string"
                },
                "instance": {
                  "type": "string"
                }
              },
              "required": ["connector", "instance"],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": ["source", "id"],
          "additionalProperties": false
        },
        "agent": true
      },
      {
        "id": "endue.social-studio.draft",
        "title": "Social Studio: make a draft",
        "keywords": ["social", "draft", "write", "post"],
        "description": "Make a draft in Social Studio (a folder under ~/Documents/Social Studio/Drafts) without publishing it: the text, a title for the networks that take one, the accounts to publish to as { connector, instance } (as accounts answers them) and pictures or videos as { path, alt } (JPEG, PNG, WebP, GIF, MP4 or QuickTime), copied into the draft. Answers the draft as drafts does.",
        "args": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 10000
            },
            "title": {
              "type": "string",
              "maxLength": 300
            },
            "accounts": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "properties": {
                  "connector": {
                    "type": "string"
                  },
                  "instance": {
                    "type": "string"
                  }
                },
                "required": ["connector", "instance"],
                "additionalProperties": false
              }
            },
            "media": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "alt": {
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "required": ["path"],
                "additionalProperties": false
              }
            }
          },
          "required": ["text"],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "draft": {
              "type": "string"
            }
          }
        },
        "agent": true
      },
      {
        "id": "endue.social-studio.drafts",
        "title": "Social Studio: drafts as data",
        "keywords": ["social", "drafts"],
        "description": "The drafts, the last changed first, as data: each with draft (its id), text, title, accounts, media (file, alt, type, size) and outcome (how each account answered: published with id and url, failed or unknown with why).",
        "args": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "drafts": {
              "type": "array"
            }
          }
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.social-studio.current",
        "title": "Social Studio: the open draft as data",
        "keywords": ["social", "draft"],
        "description": "The draft open in Social Studio now, as drafts answers it, with what was typed last; null when none is open.",
        "args": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "draft": {
              "type": ["object", "null"]
            }
          }
        },
        "agent": true,
        "readOnly": true
      },
      {
        "id": "endue.social-studio.publish",
        "title": "Social Studio: publish a draft",
        "keywords": ["social", "publish", "post"],
        "description": "Publish a draft to accounts, one after another; each answers on its own (published with id and url, refused with the problem, failed with why, or unknown when the answer was lost: look before asking again). text, title and media (file and alt, in order) must be the draft's as drafts answers them, or nothing is published: the approval shows exactly what goes out. An account that already published the draft is not published twice.",
        "args": {
          "type": "object",
          "properties": {
            "draft": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "accounts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "object",
                "properties": {
                  "connector": {
                    "type": "string"
                  },
                  "instance": {
                    "type": "string"
                  }
                },
                "required": ["connector", "instance"],
                "additionalProperties": false
              }
            },
            "text": {
              "type": "string",
              "maxLength": 10000
            },
            "title": {
              "type": "string",
              "maxLength": 300
            },
            "media": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "alt": {
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "required": ["file"],
                "additionalProperties": false
              }
            }
          },
          "required": ["draft", "accounts", "text"],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "results": {
              "type": "array"
            }
          }
        },
        "agent": true,
        "irreversible": true
      },
      {
        "id": "endue.social-studio.reply",
        "title": "Social Studio: reply to a post",
        "keywords": ["social", "reply", "comment"],
        "description": "Reply to a post, reply or mention on its network, as the account it came to. The post is { source, id } as posts and replies answer them; its account's network must take replies (capabilities.reply).",
        "args": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "connector": {
                  "type": "string"
                },
                "instance": {
                  "type": "string"
                }
              },
              "required": ["connector", "instance"],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            }
          },
          "required": ["source", "id", "text"],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "replied": {
              "type": "boolean"
            },
            "id": {
              "type": "string"
            }
          }
        },
        "agent": true,
        "irreversible": true
      },
      {
        "id": "endue.social-studio.delete",
        "title": "Social Studio: delete a post",
        "keywords": ["social", "delete", "remove"],
        "description": "Delete one of the accounts' own posts or replies on its network, where the network lets it (capabilities.delete_post, or delete_comment for a reply). The post is { source, id } as posts answers it.",
        "args": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "connector": {
                  "type": "string"
                },
                "instance": {
                  "type": "string"
                }
              },
              "required": ["connector", "instance"],
              "additionalProperties": false
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": ["source", "id"],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "deleted": {
              "type": "boolean"
            }
          }
        },
        "agent": true,
        "irreversible": true
      }
    ],
    "settings": {
      "endue.social-studio.keep-location": {
        "kind": "boolean",
        "default": false,
        "description": "Keep where a picture was taken when publishing it. Off, the desk removes the location from a picture before it leaves."
      }
    }
  }
}
